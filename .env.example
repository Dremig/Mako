# Pure mode can reuse an existing Claude CLI login. For API/gateway auth, set one:
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional Anthropic-compatible gateway and model. Pure mode accepts Claude defaults;
# the optional governed runtime requires an explicit credential and model.
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Governed-runtime controls (ignored by the default pure SDK entrypoint)
CLAUDE_SDK_TIMEOUT_SEC=120
# Native SDK JSON schemas add internal output tools; keep off for a zero-tool boundary.
CLAUDE_NATIVE_STRUCTURED_OUTPUT=0
CLAUDE_COUNTER_SESSION_RESET_STEPS=8
CLAUDE_LOCAL_MSGCHAIN=1
# Single tactical pass by default; claude_collab always enables debate.
CLAUDE_FORCE_DEBATE=false
CLAUDE_EXECUTION_MONITOR_ENABLED=0
CLAUDE_SOLVER_MODE=claude

# adaptive: semantic policies advise; guarded: semantic policies block.
MAKO_AUTONOMY_MODE=adaptive
